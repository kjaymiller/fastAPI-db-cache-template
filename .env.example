# Used directly by the app (also assembled into these for the `web` service in docker-compose.yaml)
DATABASE_URL=postgresql+asyncpg://guestbook:guestbook@localhost:5432/guestbook
VALKEY_URL=redis://localhost:6379/0

CACHE_TTL_SECONDS=900

# Used by docker-compose.yaml to configure the db/cache containers and host port mappings
POSTGRES_USER=guestbook
POSTGRES_PASSWORD=guestbook
POSTGRES_DB=guestbook
POSTGRES_PORT=5432
VALKEY_PORT=6379
